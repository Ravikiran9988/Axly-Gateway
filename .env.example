# ==============================================================================
# AXLY Gateway — Environment Configuration Template
# ==============================================================================
# DO NOT put real production credentials or committed secrets in this file.
# Copy this file to .env and configure values appropriate for your environment.

# ------------------------------------------------------------------------------
# Application Environment & Server
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
APP_NAME="AXLY Gateway"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL / Neon compatible)
# ------------------------------------------------------------------------------
# Async URL used by the FastAPI backend runtime:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/axly_gateway
# Sync URL used by Alembic migrations:
DATABASE_SYNC_URL=postgresql+psycopg://postgres:postgres@localhost:5432/axly_gateway

# Database Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# Security & Cryptography
# ------------------------------------------------------------------------------
# Master Encryption Key (AES-256-GCM): 64-character hex string (32 bytes).
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT Secret for Admin Authentication sessions:
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_secure_random_hex_jwt_secret_key_at_least_32_bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# CORS & Networking
# ------------------------------------------------------------------------------
# JSON list of allowed origins or comma-separated origins:
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["*"]

# ------------------------------------------------------------------------------
# Logging & Request Limits
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
MAX_REQUEST_SIZE_BYTES=10485760
RATE_LIMIT_DEFAULT_RPM=60
